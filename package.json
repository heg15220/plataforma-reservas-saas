{
  "name": "reserly",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotenv -e .env.local -- mvn -f apps/api/pom.xml spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:web": "dotenv -e .env.local -- npm run dev --workspace @reserly/web",
    "dev:staging": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api:staging\" \"npm:dev:web:staging\"",
    "dev:api:staging": "dotenv -e .env.staging -- mvn -f apps/api/pom.xml spring-boot:run -Dspring-boot.run.profiles=staging",
    "dev:web:staging": "dotenv -e .env.staging -- npm run dev --workspace @reserly/web",
    "env:check": "node scripts/validate-environment-examples.mjs",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:api": "mvn -f apps/api/pom.xml checkstyle:check",
    "lint:web": "npm run lint --workspace @reserly/web",
    "format": "npm run format:web && npm run format:api",
    "format:api": "mvn -f apps/api/pom.xml spotless:apply",
    "format:web": "prettier . --write",
    "format:check": "npm run format:check:web && npm run format:check:api",
    "format:check:api": "mvn -f apps/api/pom.xml spotless:check",
    "format:check:web": "prettier . --check",
    "typecheck": "npm run typecheck --workspace @reserly/web",
    "test": "npm run test:web && npm run test:api",
    "test:api": "mvn -f apps/api/pom.xml test -Dspring.profiles.active=test",
    "test:web": "npm run test --workspace @reserly/web",
    "build": "npm run build:web:local && npm run build:api",
    "build:api": "mvn -f apps/api/pom.xml package -DskipTests",
    "build:web": "npm run build --workspace @reserly/web",
    "build:web:local": "dotenv -e .env.local -- npm run build:web",
    "build:web:test": "cross-env NEXT_PUBLIC_APP_ENV=test NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 RESERLY_API_INTERNAL_URL=http://localhost:8080 npm run build:web",
    "verify": "npm run env:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:web:test && npm run build:api"
  },
  "devDependencies": {
    "concurrently": "9.2.3",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.10"
  }
}
