{
  "name": "reserly",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotenv -e .env.local -- mvn -f apps/api/pom.xml -Dspotless.check.skip=true -Dcheckstyle.skip=true spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:web": "dotenv -e .env.local -- npm run dev --workspace @reserly/web",
    "dev:demand": "dotenv -e .env.local -- python -m uvicorn --app-dir apps/demand-engine/src reserly_demand_engine.main:app --host 127.0.0.1 --port 8090 --no-access-log",
    "test:demand": "cross-env PYTHONPATH=apps/demand-engine/src;packages/demand-contracts/src python -m unittest discover -s apps/demand-engine/tests -v",
    "dev:staging": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api:staging\" \"npm:dev:web:staging\"",
    "dev:api:staging": "dotenv -e .env.staging -- mvn -f apps/api/pom.xml -Dspotless.check.skip=true -Dcheckstyle.skip=true spring-boot:run -Dspring-boot.run.profiles=staging",
    "dev:web:staging": "dotenv -e .env.staging -- npm run dev --workspace @reserly/web",
    "infra:up": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml up -d --wait",
    "infra:down": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml down",
    "infra:logs": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml logs -f",
    "infra:status": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml ps",
    "infra:config": "dotenv -e .env.local.example -- docker compose -f infrastructure/compose.yaml config --quiet",
    "db:up": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml up -d --wait postgres",
    "db:down": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml down",
    "db:logs": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml logs -f postgres",
    "db:status": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml ps postgres",
    "db:config": "dotenv -e .env.local.example -- docker compose -f infrastructure/compose.yaml config --quiet",
    "services:up": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml up -d --wait redis rabbitmq",
    "services:logs": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml logs -f redis rabbitmq",
    "services:status": "dotenv -e .env.local -- docker compose -f infrastructure/compose.yaml ps redis rabbitmq",
    "ci:check": "node scripts/validate-ci-workflow.mjs",
    "backend:conventions:check": "node scripts/validate-backend-conventions.mjs",
    "env:check": "node scripts/validate-environment-examples.mjs",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "spanish:text:check": "node scripts/validate-spanish-text.mjs",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:api": "mvn -f apps/api/pom.xml checkstyle:check",
    "lint:web": "npm run lint --workspace @reserly/web",
    "format": "npm run format:web && npm run format:api",
    "format:api": "mvn -f apps/api/pom.xml spotless:apply",
    "format:web": "prettier . --write",
    "format:check": "npm run format:check:web && npm run format:check:api",
    "format:check:api": "mvn -f apps/api/pom.xml spotless:check",
    "format:check:web": "prettier . --check",
    "typecheck": "npm run typecheck --workspace @reserly/web",
    "test": "npm run test:web && npm run test:api",
    "test:api": "mvn -f apps/api/pom.xml test -Dspring.profiles.active=test",
    "test:web": "npm run test --workspace @reserly/web",
    "build": "npm run build:web:local && npm run build:api",
    "build:api": "mvn -f apps/api/pom.xml package -DskipTests",
    "build:web": "npm run build --workspace @reserly/web",
    "build:web:local": "dotenv -e .env.local -- npm run build:web",
    "build:web:test": "cross-env NEXT_PUBLIC_APP_ENV=test NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 RESERLY_API_INTERNAL_URL=http://localhost:8080 npm run build:web",
    "verify": "npm run ci:check && npm run env:check && npm run i18n:check && npm run spanish:text:check && npm run backend:conventions:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:web:test && npm run build:api"
  },
  "devDependencies": {
    "concurrently": "9.2.3",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.10"
  }
}
