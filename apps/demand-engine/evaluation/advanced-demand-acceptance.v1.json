      "failureResponse": "disableAllocation"
    },
    {
      "category": "equity",
      "component": "opportunityCpSat",
      "testFile": "test_opportunity_optimization.py",
      "testMethod": "test_cp_sat_maximizes_value_with_capacity_budget_and_fairness",
      "invariant": "Optimization preserves bounded exposure for the operational new-venue group.",
      "failureResponse": "safeFallback"
    },
    {
      "category": "equity",
      "component": "crossCategory",
      "testFile": "test_cross_category_recommendations.py",
