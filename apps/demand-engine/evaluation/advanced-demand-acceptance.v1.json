      "failureResponse": "disablePromotions"
    },
    {
      "category": "frequency",
      "component": "waitlistAllocation",
      "testFile": "test_waitlist_allocation.py",
      "testMethod": "test_consent_frequency_and_hard_constraints_are_excluded",
