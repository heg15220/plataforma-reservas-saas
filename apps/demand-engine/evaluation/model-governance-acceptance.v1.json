    },
    {
      "category": "revocation",
      "component": "allGovernedDatasets",
      "testFile": "test_model_governance_acceptance.py",
      "testMethod": "test_revocation_is_mandatory_across_governed_datasets",
      "invariant": "Every train, discovery and analytics dataset requires revocations applied.",
      "failureResponse": "rejectInput"
    },
    {
      "category": "revocation",
      "component": "attributeDiscovery",
      "testFile": "test_attribute_discovery.py",
      "testMethod": "test_rejects_pii_sensitive_terms_and_version_drift",
      "invariant": "Privacy manifest cannot bypass runtime PII and sensitivity rejection.",
      "failureResponse": "rejectInput"
    },
    {
      "category": "promotion",
      "component": "catBoostChallenger",
      "testFile": "test_boosting_evaluation.py",
      "testMethod": "test_promotion_requires_quality_production_and_approved_cve_review",
      "invariant": "Quality, production evidence and CVE approval are conjunctive.",
      "failureResponse": "safeFallback"
    },
    {
      "category": "promotion",
      "component": "rankingExperiment",
      "testFile": "test_ab_testing.py",
      "testMethod": "test_synthetic_execution_never_allows_causal_claim",
      "invariant": "Synthetic A/B execution never permits a causal or rollout claim.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "promotion",
      "component": "attributeDiscovery",
      "testFile": "test_attribute_discovery.py",
      "testMethod": "test_executes_real_stack_and_only_emits_review_candidates",
      "invariant": "Topic discovery can only enqueue a candidate for human review.",
      "failureResponse": "requireHumanReview"
    },
    {
      "category": "promotion",
      "component": "modelCards",
      "testFile": "test_model_governance_acceptance.py",
      "testMethod": "test_model_cards_and_policies_require_human_promotion",
