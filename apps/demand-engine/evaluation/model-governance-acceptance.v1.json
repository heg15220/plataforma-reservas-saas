      "failureResponse": "rejectInput"
    },
    {
      "category": "leakage",
      "component": "noShowRisk",
      "testFile": "test_no_show_risk.py",
      "testMethod": "test_rejects_sensitive_or_outcome_feature_leakage",
      "invariant": "Sensitive and outcome fields never enter no-show risk.",
      "failureResponse": "rejectInput"
    },
    {
      "category": "calibration",
      "component": "conversionLogistic",
      "testFile": "test_conversion_training.py",
      "testMethod": "test_trains_calibrates_evaluates_and_is_deterministic",
      "invariant": "Platt calibration is isolated and ECE/Brier gates are evaluated in the future.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "calibration",
      "component": "catBoostChallenger",
      "testFile": "test_boosting_evaluation.py",
      "testMethod": "test_real_catboost_beats_baseline_but_synthetic_data_blocks_promotion",
      "invariant": "Challenger cannot regress baseline Brier or expected calibration error.",
      "failureResponse": "safeFallback"
    },
    {
      "category": "calibration",
      "component": "noShowRisk",
      "testFile": "test_no_show_risk.py",
      "testMethod": "test_trains_calibrates_and_synthetic_evidence_blocks_promotion",
      "invariant": "No-show probability passes future Brier and ECE gates before review.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "bias",
      "component": "catBoostChallenger",
      "testFile": "test_boosting_evaluation.py",
      "testMethod": "test_small_audit_segment_fails_closed",
      "invariant": "No equity conclusion is emitted for an undersized allowed cohort.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "bias",
      "component": "noShowRisk",
      "testFile": "test_no_show_risk.py",
      "testMethod": "test_small_audit_cohort_fails_closed",
      "invariant": "No-show calibration requires sufficient ES and EN audit cohorts.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "bias",
      "component": "rankingExperiment",
      "testFile": "test_ab_testing.py",
      "testMethod": "test_guardrail_breach_has_priority_and_stops",
      "invariant": "Safety and equity guardrails stop an experiment before uplift is considered.",
      "failureResponse": "stopExperiment"
    },
    {
      "category": "bias",
      "component": "conversionAnalytics",
      "testFile": "test_conversion_analytics.py",
      "testMethod": "test_small_groups_hide_all_counts_rates_and_intervals",
      "invariant": "Small permitted segments are fully suppressed rather than extrapolated.",
      "failureResponse": "suppressOutput"
    },
    {
      "category": "linguisticRobustness",
      "component": "lexicalNlp",
      "testFile": "test_nlp.py",
      "testMethod": "test_spanish_normalization_synonyms_and_multilabel",
      "invariant": "Spanish accents, synonyms and multilabel intent remain governed.",
      "failureResponse": "safeFallback"
    },
    {
      "category": "linguisticRobustness",
      "component": "lexicalNlp",
      "testFile": "test_nlp.py",
      "testMethod": "test_english_longest_phrase_and_multilabel",
