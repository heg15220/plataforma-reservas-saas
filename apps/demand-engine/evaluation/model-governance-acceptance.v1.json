{
  "schemaVersion": 1,
  "matrixVersion": "model-governance-acceptance-v1",
  "requiredCategories": [
    "reproducibility",
    "leakage",
    "calibration",
    "bias",
    "linguisticRobustness",
    "revocation",
    "promotion"
  ],
  "checks": [
    {
      "category": "reproducibility",
      "component": "conversionLogistic",
      "testFile": "test_conversion_training.py",
      "testMethod": "test_trains_calibrates_evaluates_and_is_deterministic",
      "invariant": "Same governed cohort produces identical portable parameters and metrics.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "reproducibility",
      "component": "discreteChoice",
      "testFile": "test_discrete_choice.py",
      "testMethod": "test_trains_expected_signs_and_future_fit_deterministically",
      "invariant": "Conditional logit training and evaluation replay deterministically.",
      "failureResponse": "blockPromotion"
    },
    {
      "category": "reproducibility",
      "component": "lexicalNlp",
      "testFile": "test_nlp.py",
      "testMethod": "test_replay_is_deterministic_and_response_contains_no_text",
      "invariant": "Bilingual lexical extraction is byte-equivalent for a replay.",
      "failureResponse": "safeFallback"
    },
    {
      "category": "leakage",
      "component": "conversionLogistic",
      "testFile": "test_conversion_training.py",
      "testMethod": "test_rejects_outcome_and_identity_leakage",
      "invariant": "Outcome and direct identity never enter conversion features.",
      "failureResponse": "rejectInput"
    },
    {
      "category": "leakage",
      "component": "discreteChoice",
      "testFile": "test_discrete_choice.py",
      "testMethod": "test_rejects_position_and_outcome_leakage",
