{
  "schemaVersion": 1,
  "policyVersion": "discrete-choice-training-v1",
  "algorithmVersion": "conditional-multinomial-logit-v1",
  "featureSetVersion": "choice-features-v1",
  "featureCodes": ["distanceKm", "priceTenEur", "attributeMatch", "availability", "contextMatch"],
  "expectedDirections": {
    "distanceKm": "negative",
    "priceTenEur": "negative",
    "attributeMatch": "positive",
    "availability": "positive",
    "contextMatch": "positive"
  },
  "prohibitedFeatureCodes": [
    "displayedPosition",
    "clicked",
    "bookingCompleted",
    "attendanceConfirmed",
    "customerId",
    "venuePopularityAfterChoice"
