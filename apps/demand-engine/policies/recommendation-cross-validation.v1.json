  "randomSeed": 1729,
  "businessPriorWeights": {
    "contentAffinity": 0.08,
    "serviceAffinity": 0.08,
    "visualAmbienceAffinity": 0.03,
    "availabilityRatio": 0.03,
    "alignedScarcityOpportunity": 0.04,
    "proximity": 0.04,
    "lowExposureAffinity": 0.03,
    "capacityOpportunity": 0.04,
    "historicalCategoryAffinity": 0.2,
    "commonUserHourAffinity": 0.04,
    "commonVenueHourAffinity": 0.04
  },
  "gates": {
    "maximumTrainingDecisionAccuracy": 0.9,
    "minimumTestDecisionAccuracy": 0.9,
    "maximumTestDecisionError": 0.15,
    "minimumTestPrecision": 0.8,
    "minimumTestRecall": 0.8,
    "minimumTestF1": 0.8,
    "maximumTrainTestAccuracyGap": 0.1
  },
  "automaticPromotionAllowed": false
}
