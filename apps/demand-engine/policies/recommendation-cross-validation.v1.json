{
  "schemaVersion": 1,
  "policyVersion": "recommendation-cross-validation-v1",
  "modelVersion": "contextual-recommender-cv-v1",
  "algorithmVersion": "xgboost-lambdamart-contextual-v1",
  "datasetVersion": "synthetic-marketplace-v1",
  "folds": 5,
  "topK": 3,
  "featureNames": [
    "contentAffinity",
    "serviceAffinity",
    "attributeAffinity",
    "visualAmbienceAffinity",
    "availabilityRatio",
    "alignedScarcityOpportunity",
    "qualityScore",
    "proximity",
    "priceFit",
    "lowExposureAffinity",
    "capacityOpportunity",
    "historicalCategoryAffinity",
    "commonUserHourAffinity",
    "commonVenueHourAffinity",
    "isNewVenue"
  ],
  "hyperparameters": [
    {"nEstimators": 30, "maximumDepth": 2, "learningRate": 0.05, "l2Penalty": 3.0},
    {"nEstimators": 50, "maximumDepth": 2, "learningRate": 0.05, "l2Penalty": 5.0},
    {"nEstimators": 50, "maximumDepth": 3, "learningRate": 0.04, "l2Penalty": 5.0}
