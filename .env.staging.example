# Copiar como .env.staging solo para pruebas locales del perfil.
# En el despliegue real, inyectar valores desde el gestor de secretos.
RESERLY_ENVIRONMENT=staging
SPRING_PROFILES_ACTIVE=staging

RESERLY_PUBLIC_BASE_URL=https://api.staging.reserly.example
RESERLY_WEB_BASE_URL=https://staging.reserly.example
RESERLY_ALLOWED_ORIGINS=https://staging.reserly.example
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://api.staging.reserly.example
RESERLY_API_INTERNAL_URL=http://reserly-api:8080

RESERLY_SECURE_COOKIES=true
RESERLY_REAL_PAYMENTS_ENABLED=false

RESERLY_DATABASE_NAME=reserly
RESERLY_DATABASE_PORT=5432
RESERLY_DATABASE_URL=jdbc:postgresql://postgres.internal:5432/reserly
RESERLY_DATABASE_USERNAME=replace-from-secret-manager
RESERLY_DATABASE_PASSWORD=replace-from-secret-manager
RESERLY_REDIS_URL=replace-from-secret-manager
RESERLY_RABBITMQ_URL=replace-from-secret-manager
RESERLY_S3_ENDPOINT=replace-from-deployment-config
RESERLY_S3_BUCKET=reserly-staging
RESERLY_S3_ACCESS_KEY=replace-from-secret-manager
RESERLY_S3_SECRET_KEY=replace-from-secret-manager
