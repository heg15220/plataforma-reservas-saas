# Perfil de aplicación
RESERLY_ENVIRONMENT=local
SPRING_PROFILES_ACTIVE=local

# URLs públicas e internas
RESERLY_PUBLIC_BASE_URL=http://localhost:8080
RESERLY_WEB_BASE_URL=http://localhost:3000
RESERLY_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
RESERLY_API_INTERNAL_URL=http://localhost:8080

# Seguridad y características sensibles
RESERLY_SECURE_COOKIES=false
RESERLY_REAL_PAYMENTS_ENABLED=false

# Verificación empresarial remota
RESERLY_BUSINESS_VERIFICATION_CONNECT_TIMEOUT=2s
RESERLY_BUSINESS_VERIFICATION_READ_TIMEOUT=5s
RESERLY_BUSINESS_VERIFICATION_MAX_ATTEMPTS=3
RESERLY_BUSINESS_VERIFICATION_INITIAL_BACKOFF=250ms
RESERLY_BUSINESS_VERIFICATION_MAX_BACKOFF=2s
RESERLY_BUSINESS_VERIFICATION_BACKOFF_MULTIPLIER=2.0

# PostgreSQL/PostGIS local
RESERLY_DATABASE_NAME=reserly
RESERLY_DATABASE_PORT=5432
RESERLY_DATABASE_URL=jdbc:postgresql://localhost:5432/reserly?ApplicationName=reserly-api
RESERLY_DATABASE_USERNAME=reserly
RESERLY_DATABASE_PASSWORD=reserly-local-only-change-me

# Redis local: cache, rate limits y TTL auxiliares
RESERLY_REDIS_PORT=6379
RESERLY_REDIS_PASSWORD=reserly-redis-local-only-change-me
RESERLY_REDIS_URL=redis://:reserly-redis-local-only-change-me@localhost:6379

# RabbitMQ local: trabajos asíncronos
RESERLY_RABBITMQ_PORT=5672
RESERLY_RABBITMQ_MANAGEMENT_PORT=15672
RESERLY_RABBITMQ_USERNAME=reserly
RESERLY_RABBITMQ_PASSWORD=reserly-rabbit-local-only-change-me
RESERLY_RABBITMQ_URL=amqp://reserly:reserly-rabbit-local-only-change-me@localhost:5672

# Contratos reservados para almacenamiento de archivos
RESERLY_S3_ENDPOINT=http://localhost:9000
RESERLY_S3_BUCKET=reserly-local
RESERLY_S3_ACCESS_KEY=replace-with-local-access-key
RESERLY_S3_SECRET_KEY=replace-with-local-secret-key
