# Referencia contractual. No copiar ni almacenar secretos reales en disco.
RESERLY_ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=production

RESERLY_PUBLIC_BASE_URL=https://api.reserly.example
RESERLY_WEB_BASE_URL=https://reserly.example
RESERLY_ALLOWED_ORIGINS=https://reserly.example
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.reserly.example
RESERLY_API_INTERNAL_URL=http://reserly-api:8080

RESERLY_SECURE_COOKIES=true
RESERLY_REAL_PAYMENTS_ENABLED=false
# No completar en archivo: FUC, terminal y clave se inyectaran desde el gestor de secretos.
RESERLY_REDSYS_PAYMENT_ENDPOINT=https://sis.redsys.es/sis/realizarPago
RESERLY_REDSYS_MERCHANT_CODE=
RESERLY_REDSYS_TERMINAL=
RESERLY_REDSYS_SIGNING_KEY=
RESERLY_BUSINESS_CLOCK_ZONE_ID=Europe/Madrid
RESERLY_INCIDENTS_DEFAULT_ATTENDANCE_FIXED_DELAY=5m
RESERLY_INCIDENTS_DEFAULT_ATTENDANCE_INITIAL_DELAY=1m
RESERLY_PASSWORD_BCRYPT_STRENGTH=12
RESERLY_SESSION_LIFETIME=12h
RESERLY_SESSION_ACTIVITY_UPDATE_INTERVAL=5m
RESERLY_EMAIL_VERIFICATION_TOKEN_LIFETIME=24h
RESERLY_PASSWORD_RESET_TOKEN_LIFETIME=30m
RESERLY_RATE_LIMIT_ENABLED=true
RESERLY_RATE_LIMIT_LOGIN_REQUESTS=10
RESERLY_RATE_LIMIT_LOGIN_WINDOW=5m
RESERLY_RATE_LIMIT_REGISTRATION_REQUESTS=5
RESERLY_RATE_LIMIT_REGISTRATION_WINDOW=1h
RESERLY_RATE_LIMIT_PASSWORD_RESET_REQUEST_REQUESTS=5
RESERLY_RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW=15m
RESERLY_RATE_LIMIT_PASSWORD_RESET_CONSUME_REQUESTS=10
RESERLY_RATE_LIMIT_PASSWORD_RESET_CONSUME_WINDOW=15m
RESERLY_RATE_LIMIT_BUSINESS_VERIFICATION_REQUESTS=5
RESERLY_RATE_LIMIT_BUSINESS_VERIFICATION_WINDOW=1h
RESERLY_BUSINESS_VERIFICATION_CONNECT_TIMEOUT=2s
RESERLY_BUSINESS_VERIFICATION_READ_TIMEOUT=5s
RESERLY_BUSINESS_VERIFICATION_MAX_ATTEMPTS=3
RESERLY_BUSINESS_VERIFICATION_INITIAL_BACKOFF=250ms
RESERLY_BUSINESS_VERIFICATION_MAX_BACKOFF=2s
RESERLY_BUSINESS_VERIFICATION_BACKOFF_MULTIPLIER=2.0
RESERLY_BUSINESS_VERIFICATION_VALIDITY_PERIOD=365d
RESERLY_BUSINESS_VERIFICATION_NAME_MATCH_THRESHOLD=0.85
RESERLY_BUSINESS_VERIFICATION_ADDRESS_MATCH_THRESHOLD=0.75
RESERLY_VIES_ENDPOINT=https://ec.europa.eu/taxation_customs/vies/services/checkVatService
RESERLY_VIES_MAX_RESPONSE_BYTES=65536

RESERLY_DATABASE_NAME=reserly
RESERLY_DATABASE_PORT=5432
RESERLY_DATABASE_URL=jdbc:postgresql://postgres.internal:5432/reserly?sslmode=require
RESERLY_DATABASE_USERNAME=inject-from-secret-manager
RESERLY_DATABASE_PASSWORD=inject-from-secret-manager
RESERLY_REDIS_PORT=6379
RESERLY_REDIS_PASSWORD=inject-from-secret-manager
RESERLY_REDIS_URL=inject-from-secret-manager
RESERLY_RABBITMQ_PORT=5672
RESERLY_RABBITMQ_MANAGEMENT_PORT=15672
RESERLY_RABBITMQ_USERNAME=inject-from-secret-manager
RESERLY_RABBITMQ_PASSWORD=inject-from-secret-manager
RESERLY_RABBITMQ_URL=inject-from-secret-manager
RESERLY_DOCUMENT_MAX_BYTES=10485760
RESERLY_DOCUMENT_REQUEST_MAX_BYTES=11534336
RESERLY_DOCUMENT_ENCRYPTION_KEY_ID=inject-key-version
RESERLY_DOCUMENT_ENCRYPTION_KEY_BASE64=inject-from-secret-manager
RESERLY_S3_PORT=9000
RESERLY_S3_CONSOLE_PORT=9001
RESERLY_S3_ENDPOINT=inject-from-deployment-config
RESERLY_S3_BUCKET=reserly-production
RESERLY_S3_ACCESS_KEY=inject-from-secret-manager
RESERLY_S3_SECRET_KEY=inject-from-secret-manager
RESERLY_S3_REGION=eu-west-1
RESERLY_S3_CREATE_BUCKET=false
RESERLY_MLFLOW_PORT=5000
RESERLY_MLFLOW_TRACKING_URI=https://mlflow.reserly.example
RESERLY_MLFLOW_DATABASE_NAME=mlflow
RESERLY_MLFLOW_DATABASE_USERNAME=inject-from-secret-manager
RESERLY_MLFLOW_DATABASE_PASSWORD=inject-from-secret-manager-at-least-32-characters
RESERLY_MLFLOW_ADMIN_USERNAME=inject-from-secret-manager
RESERLY_MLFLOW_ADMIN_PASSWORD=inject-from-secret-manager-at-least-32-characters
RESERLY_MLFLOW_FLASK_SECRET_KEY=inject-from-secret-manager-at-least-32-characters
RESERLY_MLFLOW_ALLOWED_HOSTS=mlflow.reserly.example,mlflow:5000
RESERLY_MLFLOW_S3_BUCKET=reserly-production-mlflow
RESERLY_VENUE_IMAGE_S3_BUCKET=reserly-production-venue-images
RESERLY_VENUE_IMAGE_MAX_BYTES=5242880
RESERLY_VENUE_IMAGE_MIN_DIMENSION=320
RESERLY_VENUE_IMAGE_MAX_DIMENSION=4096
RESERLY_VENUE_IMAGE_MAX_PIXELS=16777216
RESERLY_CLAMAV_HOST=clamav.internal
RESERLY_CLAMAV_PORT=3310
RESERLY_CLAMAV_CONNECT_TIMEOUT=2s
RESERLY_CLAMAV_READ_TIMEOUT=20s

# Email transaccional Brevo; remitente verificado y credenciales proceden de secretos.
RESERLY_EMAIL_ENABLED=true
RESERLY_EMAIL_PROVIDER=brevo
RESERLY_EMAIL_FROM_ADDRESS=notifications@reserly.example
RESERLY_EMAIL_FROM_NAME=Reserly
RESERLY_EMAIL_SMTP_HOST=smtp-relay.brevo.com
RESERLY_EMAIL_SMTP_PORT=465
RESERLY_EMAIL_SMTP_USERNAME=inject-from-secret-manager
RESERLY_EMAIL_SMTP_PASSWORD=inject-from-secret-manager
RESERLY_EMAIL_SMTP_AUTH=true
RESERLY_EMAIL_SMTP_STARTTLS=false
RESERLY_EMAIL_SMTP_STARTTLS_REQUIRED=false
RESERLY_EMAIL_SMTP_SSL=true
RESERLY_EMAIL_SMTP_CONNECTION_TIMEOUT_MS=3000
RESERLY_EMAIL_SMTP_READ_TIMEOUT_MS=5000
RESERLY_EMAIL_SMTP_WRITE_TIMEOUT_MS=5000

# Conservación de incidencias y penalizaciones; validar plazos jurídicamente antes de activar
RESERLY_INCIDENT_RETENTION_OPERATIONAL_MONTHS=12
RESERLY_INCIDENT_RETENTION_EVIDENCE_MONTHS=36
RESERLY_INCIDENT_RETENTION_CRON="0 45 2 * * *"
RESERLY_DEMAND_ENGINE_ENVIRONMENT=production
RESERLY_DEMAND_ENGINE_HOST=0.0.0.0
RESERLY_DEMAND_ENGINE_PORT=8090
RESERLY_DEMAND_ENGINE_SERVICE_ID=spring-api
RESERLY_DEMAND_ENGINE_SERVICE_TOKEN=replace-with-secret-manager-value-at-least-32-characters
RESERLY_DEMAND_ENGINE_REQUEST_TIMEOUT_SECONDS=0.2
RESERLY_DEMAND_ENGINE_MAXIMUM_REQUEST_BYTES=65536
RESERLY_DEMAND_ENGINE_DOCS_ENABLED=false
RESERLY_DEMAND_ENGINE_LOG_LEVEL=INFO
RESERLY_DEMAND_IDENTITY_HMAC_ACTIVE_VERSION=hmac-production-v1
RESERLY_DEMAND_IDENTITY_HMAC_ACTIVE_SECRET=inject-from-secret-manager-at-least-32-characters
RESERLY_DEMAND_IDENTITY_HMAC_PREVIOUS_VERSION=
RESERLY_DEMAND_IDENTITY_HMAC_PREVIOUS_SECRET=
RESERLY_DEMAND_IDENTITY_CUSTOMER_RETENTION=365d
RESERLY_DEMAND_IDENTITY_LINK_RETENTION=90d
